# Debug aid: default the USB gadget to CDC/NCM networking so we can reach
# the device over USB-C when the display/UI is broken and there is no way
# to pick this in Settings. Only seeds the config if none exists yet, so a
# later user choice in Settings is never overwritten. Remove once the
# display issue is fixed and UI-driven configuration works again.
mkdir -p /storage/.cache/usbgadget
if [ ! -f /storage/.cache/usbgadget/usbgadget.conf ]; then
  echo "USB_MODE=cdc" > /storage/.cache/usbgadget/usbgadget.conf
fi
